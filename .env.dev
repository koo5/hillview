# Dev-only defaults. Safe to commit. NOT for production.

POSTGRES_DB=hillview
POSTGRES_USER=hillview
POSTGRES_PASSWORD=hillview
SECRET_KEY=dev-insecure-change-me

TEST_USERS=true
DEV_MODE=true
NO_LIMITS=true
DEBUG_ENDPOINTS=true


# PANORAMAX_BASE_URL defaults to http://localhost:8058. A box that serves it
# through its Caddy (handle_path /geovisio/*) declares it per machine, as an
# `env` entry in hosts.toml, so it lands in .env's set_host block.
