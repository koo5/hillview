<?xml version="1.0" encoding="utf-8"?>
<!--
  The instrumented test APK is its OWN package (cz.hillview.shared.test) and does
  not inherit the app's permissions. Without this, every device test that touches
  the IMU ran at the 200 Hz fallback rate and could never exercise the FASTEST
  path the app actually uses — a device suite quietly testing a configuration the
  product never ships.

  Found by reading the log rather than the result: the test passed while
  hv-GeoEngine warned "IMU registration at 0µs not permitted", which was also a
  clean demonstration that the fallback works (see GeoEngine.registerImu).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
</manifest>
