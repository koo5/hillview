<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Explicit even though some library manifests merge it in — the app's
         own networking (auth, uploads) must not depend on a transitive
         declaration. ACCESS_NETWORK_STATE backs the shared-kt drain's
         metered/wifi-only checks (ConnectivityManager). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Accelerometer/gyroscope above 200 Hz, for the IMU window around an
         exposure (GeoEngine.startImuSensors, SENSOR_DELAY_FASTEST). A NORMAL
         permission: granted at install, no runtime prompt, no user-visible
         dialog. Required since Android 12 (API 31) — without it
         registerListener THROWS SecurityException rather than quietly clamping
         the rate, which crashed the app on startup the first time this reached
         a real phone. The high rate is the point: the shape of the signal
         across a 1/60 s shutter is what the window is for, and 200 Hz cannot
         describe it. See docs/recon-capture-metadata.md. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- Upload notifications (shared-kt NotificationHelper / PhotoUploadWorker). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- PhotoUploadWorker promotes to a dataSync foreground service via a
         typed ForegroundInfo; on targetSdk 34+ the runtime refuses that
         against a typeless service. Same patches as the Tauri plugin
         manifest (verified 2026-08 on WorkManager 2.10.5): WorkManager
         declares NEITHER the DATA_SYNC subtype permission NOR a typed
         SystemForegroundService — the app must. Normal-protection,
         auto-granted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- The external-camera mode's tracking service: records location and
         heading while ANOTHER app (the system camera) owns the foreground,
         which is exactly what the `location` foreground type exists for. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".HillviewApplication"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Float mode: the map in a PiP window over the phone's camera app
             (see cz.hillview.pip). resizeableActivity is required for PiP to
             be offered at all; smallestScreenSize joins the configChanges
             list because the PiP window is a size change the activity must
             ride out rather than be recreated by. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- tools:node="merge" combines this with WorkManager's own <service>
             declaration, adding the dataSync type without replacing
             anything else. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <service
            android:name="cz.hillview.external.ExternalCameraService"
            android:foregroundServiceType="location"
            android:exported="false" />
    </application>

</manifest>
