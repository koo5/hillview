JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
API_JWT_PUBLIC_KEY=""


PARALLEL_PROCESSING_CONCURRENCY=20
PARALLEL_PROCESSING_START_DELAY=0.1

MAX_IMAGE_PIXELS=10000000000
MAX_IMAGE_WIDTH=300000
MAX_IMAGE_HEIGHT=30000
MAX_FILE_SIZE=10000000000

# Enable non-JPEG inputs and external pyramids only on trusted auxiliary workers.
# These additional decoder paths may need further security audits.
# Opt-in re-enables system OpenEXR with outstanding decoder advisories.
# Dimension, memory and disk limits still need to suit the workload.
HILLVIEW_AUX=0
# With HILLVIEW_AUX=1, non-JPEG input is still refused in an upload body and
# accepted only from local_photo_path (a file under LOCAL_PHOTO_ROOTS): upload
# tokens are not bound to a worker, so any signed-in account can reach this one.
# Set to 1 only if every client that can reach this worker is trusted.
ALLOW_AUX_FORMATS_IN_UPLOADS=0
