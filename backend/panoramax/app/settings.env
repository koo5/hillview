# Every setting of the Panoramax service, with its default — the only place
# these defaults live. docker-compose.yml loads this file as the container's
# env_file and interpolates each value against the root .env (and the shell),
# so .env overrides any of them without the rest of .env reaching the
# container. settings.py resolves the same defaults when it runs outside
# compose (unit tests, scripts), and understands only the ${NAME:-default}
# form, nesting included.

# Which intake grants publish to the federation (SCOPES in settings.py)
PANORAMAX_SCOPE=${PANORAMAX_SCOPE:-p1}
# Public canonical base URL registered in the meta-catalog. Its last
# characters must not be '/', 'a', 'p' or 'i' (the catalog rstrip("/api")s
# the whole string); any *.hillview.cz host is safe.
PANORAMAX_BASE_URL=${PANORAMAX_BASE_URL:-http://localhost:8058}
# Where "/" sends humans following the catalog's per-item rel=via link:
# the stack's own frontend (FRONTEND_URL, which set_host.py writes from
# the host profile) unless overridden, else hillview.cz
PANORAMAX_VIEWER_URL=${PANORAMAX_VIEWER_URL:-${FRONTEND_URL:-https://hillview.cz}}
PANORAMAX_INSTANCE_NAME=${PANORAMAX_INSTANCE_NAME:-Hillview}
# The logo the meta-catalog shows for us (/api/configuration `logo`)
PANORAMAX_LOGO_URL=${PANORAMAX_LOGO_URL:-https://hillview.cz/favicon.png}
# DEV_MODE (the api's switch) enables /dev/ pages such as /dev/suspicious,
# which links to an explorer when PANORAMAX_EXPLORER_URL names one
DEV_MODE=${DEV_MODE:-}
PANORAMAX_EXPLORER_URL=${PANORAMAX_EXPLORER_URL:-}
# One contribution per grid cell (edge in projected metres) and compass sector
PANORAMAX_CELL_SIZE_M=${PANORAMAX_CELL_SIZE_M:-2}
PANORAMAX_BEARING_BUCKETS=${PANORAMAX_BEARING_BUCKETS:-12}
# A pause longer than this between captures starts a new sequence
PANORAMAX_SESSION_GAP_HOURS=${PANORAMAX_SESSION_GAP_HOURS:-0.5}
PANORAMAX_SEQUENCER_INTERVAL_S=${PANORAMAX_SEQUENCER_INTERVAL_S:-300}
# false runs the API without the in-process sequencer
PANORAMAX_SEQUENCER_ENABLED=${PANORAMAX_SEQUENCER_ENABLED:-true}
