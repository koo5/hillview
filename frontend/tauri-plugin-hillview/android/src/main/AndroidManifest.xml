<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">


    <!-- Required for background uploads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Required for camera access -->
    <uses-permission android:name="android.permission.CAMERA" />

	<!-- bad -->
	<!--    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />-->


    <!-- Required for accessing photos -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- For Android 13+ (API 33+) - Granular media permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Required for precise location services -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Required for notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<!--    <uses-permission android:name="android.permission.VIBRATE" />-->

    <!-- PhotoUploadWorker promotes to a dataSync foreground service via a
         typed ForegroundInfo; on targetSdk 34+ the runtime refuses that
         against a typeless service. Verified 2026-08 on WorkManager 2.10.5 +
         compileSdk 36: contrary to the old "2.10 bundles these" note, the
         merged manifest still contains NEITHER the DATA_SYNC subtype
         permission NOR a typed SystemForegroundService — WorkManager leaves
         the type declaration to the app (it can't know which subtype an app
         uses). So both patches stay. Normal-protection, auto-granted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <!-- tools:node="merge" combines this with WorkManager's own <service>
             declaration, adding the type without replacing anything else. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Deep link intent filters are added directly to MainActivity by Tauri's deep-link plugin -->

        <!-- FCM notification action handling for MainActivity -->
<!--        <activity android:name="cz.hillview.plugin.CustomMainActivity"-->
<!--				  android:exported="false">-->
<!--            <intent-filter>-->
<!--                <action android:name="VIEW_RECENT_ACTIVITY" />-->
<!--                <category android:name="android.intent.category.DEFAULT" />-->
<!--            </intent-filter>-->
<!--        </activity>-->

		<!-- Notification actions are handled by MainActivity through ExamplePlugin.onNewIntent() -->

		<service android:name="cz.hillview.plugin.PushServiceImpl"
			android:exported="false">
			<intent-filter>
				<action android:name="org.unifiedpush.android.connector.PUSH_EVENT"/>
			</intent-filter>
		</service>

        <!-- Firebase Cloud Messaging service for direct FCM support -->
        <service
            android:name="cz.hillview.plugin.FcmDirectService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
