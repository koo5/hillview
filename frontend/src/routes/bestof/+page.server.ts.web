import type { PageServerLoad } from './$types';
import { backendInternalUrl } from '$lib/config.server';
import { parsePageParam } from '$lib/bestofPaging';

/**
 * Server-renders one page of the ranking. ?page=N is the crawlable, shareable
 * address of a position: Googlebot does not scroll a lazy-loading list to its
 * end, so depth has to be reachable by following ordinary <a href> links, and
 * each of those links needs a server-rendered page behind it.
 *
 * The page number goes to the API as-is — the slice size and the step between
 * slices are the API's business (BESTOF_PAGE_SIZE in bestof_routes.py), because
 * they are the same number and splitting them across two codebases is how they
 * silently drift apart. The lazy-loader then continues by asking for page N+1,
 * so entering at page 5 and scrolling behaves exactly like entering at page 1
 * and scrolling — one way of saying where you are, for readers and crawlers.
 */
export const load: PageServerLoad = async ({ fetch, url }) => {
	const page = parsePageParam(url.searchParams.get('page'));
	const empty = { photos: [], has_more: false, page };
	try {
		const apiUrl = new URL(`${backendInternalUrl}/bestof/photos`);
		apiUrl.searchParams.set('page', String(page));
		const response = await fetch(apiUrl.toString());

		if (!response.ok) {
			console.error('bestof SSR: backend returned HTTP', response.status);
			return empty;
		}

		const data = await response.json();
		return {
			photos: data.photos ?? [],
			has_more: data.has_more ?? false,
			page: data.page ?? page
		};
	} catch (error) {
		console.error('bestof SSR: failed to fetch:', error);
		return empty;
	}
};
