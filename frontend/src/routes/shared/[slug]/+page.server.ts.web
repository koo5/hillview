import { error } from '@sveltejs/kit';
import type { PageServerLoad } from './$types';
import { backendInternalUrl } from '$lib/config.server';
import { loadPhotoPreview } from '$lib/photoPreview.server';
import { HILLVIEW_BASE_URL } from '$lib/urlUtilsServer';

// Serve a complete HTML preview at the shared URL itself. A messenger should
// not need to follow a redirect or execute JavaScript to discover the card.
// Browsers continue to the saved map view after hydration.
export const load: PageServerLoad = async ({ params, fetch, locals }) => {
	const res = await fetch(`${backendInternalUrl}/shared/${encodeURIComponent(params.slug)}`);

	if (res.status === 404) {
		throw error(404, 'Share link not found');
	}
	if (!res.ok) {
		console.error('shared/[slug] SSR: resolve endpoint HTTP', res.status);
		throw error(502, 'Failed to resolve share link');
	}

	const data = await res.json();
	const target = new URL(data.target, HILLVIEW_BASE_URL);
	const preview = await loadPhotoPreview(target.searchParams.get('photo'), fetch, locals);
	return { target: data.target as string, ...preview };
};
