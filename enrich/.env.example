# Enrichment Workbench — copy to .env and adjust.
# All host ports bind 127.0.0.1 only.

# Workbench's own Postgres (PostGIS) — mirrors, runs, sync state
WB_POSTGRES_DB=enrich
WB_POSTGRES_USER=enrich
WB_POSTGRES_PASSWORD=enrich
WB_POSTGRES_HOST_PORT=15432

# Oxigraph (facts as RDF quads)
OXIGRAPH_HOST_PORT=7878

# Workbench API / web
ENRICH_API_HOST_PORT=8070
ENRICH_WEB_HOST_PORT=8071

# Source-of-truth Hillview DB the mirror-sync READS (never writes).
# Default targets the local dev stack over the shared docker network
# (api container joins hillview_network; "postgres" resolves there).
# Later: point at a prod read-only role over a tunnel — one variable.
HILLVIEW_DB_URL=postgresql+asyncpg://hillview:hillview@postgres:5432/hillview

# Allow raw SPARQL UPDATE via POST /api/sparql (full-quads fun escape hatch)
ENRICH_ALLOW_RAW_UPDATE=0

# Overpass instance for the peaks/towers/places label-candidate queries (the
# main overpass-api.de gets overloaded; overpass.openstreetmap.fr held up
# well). Fetches are per 0.5° tile, cached, deduplicated across clients, and
# SERIALIZED: at most OVERPASS_CONCURRENCY in flight globally (default 1).
# OVERPASS_TILE_TIMEOUT_S is the server-side [timeout:] budget per tile
# (default 60; the HTTP timeout rides 15 s above it).
#OVERPASS_URL=https://overpass-api.de/api/interpreter
#OVERPASS_CONCURRENCY=1
#OVERPASS_TILE_TIMEOUT_S=60

# Terrain worker (containerized): GLO-30 coverage is WORLDWIDE ON DEMAND —
# each render fetches whatever 1° tiles its window still misses (~60 MB each;
# ocean gaps remembered) and refreshes the VRT. This bbox is only a warm
# cache downloaded at container start so the first render in your home area
# doesn't wait (lon_w,lat_s,lon_e,lat_n; default CZ + margin, ~2 GB).
#TERRAIN_AUTO_DEM_BBOX=11.5,47.5,19.5,51.5
# Fine ČÚZK mosaics instead (mount them into the container and point these
# at the in-container paths) — the auto GLO-30 path then steps aside:
#TERRAIN_DSM_PATH=
#TERRAIN_DTM_PATH=
# Named stacks selectable per render (UI's DEM dropdown → dsm_stack param).
# glo30 is auto-wired by the container entrypoint. cuzk auto-builds when a
# bbox is set: DMP 1G + DMR 5G sheets → pdal rasterize → 10 m near ring,
# incremental (a bigger bbox later just adds sheets; the whole-republic
# overnight prefetch is the same machinery — see terrain/README.md).
#TERRAIN_AUTO_CUZK_BBOX=14.43,50.08,14.55,50.16
# When the auto stack is live, a render OUTSIDE the built rings first extends
# them on demand (±radius around the viewpoint, incremental, lock-serialized;
# ~550 MB per new area at the default 5 km). =0 disables — such renders then
# just fall through to GLO-30.
#TERRAIN_AUTO_CUZK_FETCH=1
#TERRAIN_AUTO_CUZK_RADIUS_M=5000
# …or point at pre-built mosaics instead (mount + in-container paths):
#TERRAIN_DSM_PATH_CUZK=
#TERRAIN_DTM_PATH_CUZK=
#TERRAIN_ATTRIBUTION_CUZK=

# Browser origins allowed to call the API (CORS). Default covers the workbench
# web UI (:8071) and the main hillview frontend — vite dev (:8212) and the
# Caddy origin (https://hillview.dev4.local) — whose terrain mode calls
# /api/terrain/* directly. Comma-separated; empty uses the default.
#ENRICH_CORS_ORIGINS=
